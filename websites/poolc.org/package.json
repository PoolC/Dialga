{
  "name": "@dialga/poolc.org",
  "description": "poolc.org website",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "yarn start",
    "build": "vite build",
    "sync:type": "yarn dlx typesync",
    "check:type": "tsc",
    "check:responsive": "node scripts/check-responsive-breakpoints.mjs",
    "check:type:watch": "yarn check:type --watch",
    "codegen": "dotenv -e ./.env -- bash -c 'openapi -i $VITE_API_BASE_URL/v2/api-docs -o src/lib/api-v2/__generated__ --useUnionTypes --useOptions -c axios'",
    "postinstall": "yarn codegen",
    "lint": "eslint . && prettier . --check --ignore-path .gitignore",
    "format": "eslint . --fix && prettier . --write --ignore-path .gitignore"
  },
  "dependencies": {
    "@dialga/react-editor": "workspace:^",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^18.15.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.0",
    "openapi-typescript-codegen": "^0.28.0",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^5.2.7"
  },
  "type": "module"
}
